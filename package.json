{
  "name": "sqlens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "clean": "rm -rf dist server.js .next",
    "lint": "tsc --noEmit",
    "verify:curriculum": "tsx scripts/verify-curriculum.ts",
    "test": "vitest run",
    "test:engine": "tsx scripts/engine-tests.ts",
    "test:module-order": "tsx scripts/module-order-check.ts",
    "test:db-lifecycle": "tsx scripts/db-lifecycle-check.ts",
    "test:manual-pass": "tsx scripts/day1920-manual-pass.ts",
    "audit:equivalence": "tsx scripts/probe-equivalence.ts",
    "audit:equivalence:tasks": "tsx scripts/audit-equivalence.ts",
    "audit:validation-overlap": "tsx scripts/count-validation-overlap.ts",
    "audit:keyword-case": "tsx scripts/audit-keyword-case.ts",
    "audit:atomicity": "tsx scripts/audit-atomicity.ts",
    "audit:grading-pipeline": "tsx scripts/audit-grading-pipeline.ts",
    "audit:grading-policy": "tsx scripts/audit-grading-policy.ts",
    "audit:taught-before-tested": "tsx scripts/audit-taught-before-tested.ts",
    "audit:custom-validators": "tsx scripts/audit-custom-validators.ts",
    "audit:all": "npm run verify:curriculum && npx tsx scripts/audit-all-tasks.ts && npm run audit:equivalence && npm run audit:equivalence:tasks && npm run audit:validation-overlap && npm run audit:keyword-case && npm run audit:grading-pipeline && npm run audit:grading-policy && npm run audit:taught-before-tested && npm run audit:custom-validators"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.7.1",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.6.0",
    "motion": "^12.23.24",
    "next": "^16.3.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.11"
  }
}
