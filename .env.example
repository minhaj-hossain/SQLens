# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Better Auth (email/password + MongoDB adapter)
# -----------------------------------------------------------------------------

# BETTER_AUTH_SECRET: Secret used for hashing/signing/encrypting. Must be at
# least 32 characters, generated with high entropy.
#   Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="REPLACE_WITH_32_CHAR_RANDOM_SECRET"

# BETTER_AUTH_URL: Public base URL of the app (used for cookies & redirects).
# In production set this to the deployed URL (e.g. https://your-app.com).
BETTER_AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# MongoDB — uses the official `mongodb` driver connection string (URI).
#   - Local:   mongodb://user:pass@localhost:27017/dbname
#   - Atlas:   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/dbname
# The database name is read from the URI unless MONGODB_DB_NAME is set.
MONGODB_URI="mongodb://localhost:27017/sqlens"
MONGODB_DB_NAME="sqlens"

# Port the Express server binds to (server/index.ts).
PORT=3000
