# -----------------------------------------------------------------------------
# SQLens environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# -----------------------------------------------------------------------------

# BETTER_AUTH_SECRET: Secret used for hashing/signing/encrypting sessions.
# Must be at least 32 characters with high entropy.
#   Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="REPLACE_WITH_32_CHAR_RANDOM_SECRET"

# BETTER_AUTH_URL: Public base URL of the app (used for cookies & redirects).
# In production set this to the deployed URL (e.g. https://your-app.vercel.app).
BETTER_AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# MongoDB — official `mongodb` driver connection string.
#   - Local:   mongodb://user:pass@localhost:27017/dbname
#   - Atlas:   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/dbname
# The database name is read from the URI unless MONGODB_DB_NAME is set.
# -----------------------------------------------------------------------------
MONGODB_URI="mongodb://localhost:27017/sqlens"
MONGODB_DB_NAME="sqlens"

